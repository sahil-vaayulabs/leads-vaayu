# ── QuickCRM environment ──────────────────────────────────────────────────
# Local dev:   cp .env.example .env
# VPS deploy:  cp .env.example .env.prod   (deploy.sh reads .env.prod)
#
# MongoDB runs on the VPS on the shared `vaayu_os` network — no mongo
# containers are started by this compose file; we only connect to it.

# ── MongoDB ───────────────────────────────────────────────────────────────

# Local dev with Homebrew MongoDB (running on your machine):
MONGODB_URI=mongodb://host.docker.internal:27017

# VPS — mongo container on the shared `vaayu_os` network (external):
# MONGODB_URI=mongodb://mongo:27017

# ── Database ──────────────────────────────────────────────────────────────

DB_NAME=quickcrm
